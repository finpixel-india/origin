# ─── ORIGIN environment variables ───
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit the real .env file — it's in .gitignore.

# PostgreSQL connection string used by Drizzle (required)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign session cookies (required in production)
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# ─── Optional: Google Sign-In ───
# Leave blank to hide the Google button. ID/password login works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of your deployed site (used for Google OAuth redirect).
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
